# ============================================================
# Environment Variable Template — DO NOT put real values here
# Copy this file to .env and fill in your actual values
# .env is gitignored and must NEVER be committed
# ============================================================

# Databricks (only needed if running outside Databricks notebooks)
DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net
DATABRICKS_TOKEN=<your-personal-access-token>

# Unity Catalog (defaults are already set in the notebook config)
CATALOG_NAME=hh_revenue_leakage
BRONZE_SCHEMA=bronze
SILVER_SCHEMA=silver
GOLD_SCHEMA=gold

# MLflow (auto-configured inside Databricks — only set if running externally)
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Users/<your-email>/revenue-leakage-detection
